# Copy to .env.local and fill in. Names and safe defaults only — never put a secret here.

# --- Gemma 4 (open-weight model) -------------------------------------------
# Where Gemma runs: auto | google | ollama
#   auto   = Google AI Studio when GOOGLE_GENERATIVE_AI_API_KEY is set, otherwise Ollama
#   google = Google AI Studio (free tier; Google may use the data)
#   ollama = Ollama on your own machine (or reached through a tunnel)
GEMMA_PROVIDER=auto
# Optional per-role overrides, e.g. run the photo check on your own machine:
# GEMMA_WRITER_PROVIDER=google
# GEMMA_READER_PROVIDER=ollama
# GEMMA_NARRATOR_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# Google model IDs (Gemma only; other models are refused). The narrator uses the reader model
# unless GEMMA_NARRATOR_MODEL is set.
GEMMA_WRITER_MODEL=gemma-4-31b-it
GEMMA_READER_MODEL=gemma-4-26b-a4b-it
# GEMMA_NARRATOR_MODEL=gemma-4-26b-a4b-it
# Thinking per role: minimal | high (Gemma on AI Studio accepts only these two).
# GEMMA_WRITER_THINKING=high
# GEMMA_READER_THINKING=minimal
# GEMMA_NARRATOR_THINKING=minimal
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b

# --- Places and facts (SerpApi first, Wikipedia second) ----------------------
SERPAPI_API_KEY=
WIKIPEDIA_USER_AGENT=ForkingPaths/0.1 (https://github.com/asi-mir/forking-paths; you@example.com)

# --- Voice -------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4

# --- Database ----------------------------------------------------------------
# Local: docker run -d -p 27017:27017 mongo:8
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=forking-paths

# --- Budget guard (daily caps; tune to your credits) --------------------------
# Free tiers: SerpApi 250 searches/month (≤ 6 per new quest); ElevenLabs 10k characters/month.
BUDGET_QUESTS_PER_DAY=3
BUDGET_TTS_CHARS_PER_DAY=4000

# --- Sentry (tracing; optional) ---------------------------------------------
# Leave the DSNs empty to turn Sentry off: nothing is initialised and nothing is sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for traces (defaults to NODE_ENV), e.g. production on the host. Set the public
# one to label browser and server spans alike; SENTRY_ENVIRONMENT overrides it on the server.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
# Source maps upload only from a hosted build (RENDER=true or CI=true) with all three set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_DEBUG=1 prints what the SDK does (server).
